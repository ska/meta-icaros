MACHINE ??= "kirkwood-goflexnet"
DISTRO ?= "icaros-nas"

# Password hash for the "ska" admin user (see nasusers.bbclass).
# Generate with: openssl passwd -6 'mypassword'  and escape every '$' as '\$'
#ICAROS_ADMIN_HASH = ""

USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"
CONF_VERSION = "2"
