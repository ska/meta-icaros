#!/bin/sh
#
# rcS		Call all S??* scripts in /etc/rcS.d in
#		numerical/alphabetical order.
#
# Version:	@(#)/etc/init.d/rcS  2.76  19-Apr-1999  miquels@cistron.nl
#

PATH=/sbin:/bin:/usr/sbin:/usr/bin
runlevel=S
prevlevel=N
umask 022
export PATH runlevel prevlevel

#	Make sure proc is mounted
#
[ -d "/proc/1" ] || mount /proc

#
#	Source defaults.
#
. /etc/default/rcS

#
#	Trap CTRL-C &c only in this shell so we can interrupt subprocesses.
#
trap ":" INT QUIT TSTP

#####################################
mount -t tmpfs -o mode=0777,nodev,nosuid,strictatime,size=1M tmpfs /run
mount -t tmpfs -o rw,size=1M tmpfs /mnt

#####################################
mkdir -p /mnt/RaidFileShare
mount -t ext3 -o rw,noatime,nobarrier,errors=remount-ro /dev/md127 /mnt/RaidFileShare

#####################################
mkswap /dev/sda3
swapon /dev/sda3
#
#	Call all parts in order.
#
exec /etc/init.d/rc S


